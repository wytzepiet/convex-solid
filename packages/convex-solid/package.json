{
  "name": "convex-solid",
  "version": "2.0.0-beta.1",
  "description": "SolidJS bindings for Convex with real-time queries, fine-grained reactivity, and full TypeScript support",
  "license": "MIT",
  "author": "Wytze Sligting",
  "repository": {
    "type": "git",
    "url": "https://github.com/wytzepiet/convex-solid.git",
    "directory": "packages/convex-solid"
  },
  "homepage": "https://github.com/wytzepiet/convex-solid#readme",
  "keywords": [
    "solid",
    "solidjs",
    "convex",
    "reactive",
    "real-time",
    "database",
    "baas",
    "hooks",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "convex": "^1.34.0",
    "solid-js": "^2.0.0-beta.7",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "convex": "^1.34.0",
    "solid-js": "^2.0.0-beta.4"
  }
}
